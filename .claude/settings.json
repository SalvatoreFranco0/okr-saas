{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git branch*)",
      "Bash(npm run *)", "Bash(npm ci)", "Bash(npm test*)", "Bash(npm audit*)",
      "Bash(npx supabase gen types*)", "Bash(npx supabase db lint*)", "Bash(npx supabase projects list)",
      "Bash(node -v)", "Bash(git --version)", "Bash(gh --version)", "Bash(gh auth status)"
    ],
    "ask": [
      "Bash(git commit*)", "Bash(git push*)", "Bash(gh pr *)",
      "Bash(npx supabase db push*)", "Bash(npx supabase functions deploy*)", "Bash(npx supabase link*)",
      "Bash(npm install*)", "Bash(npm i *)"
    ],
    "deny": [
      "Read(**/.env)", "Read(**/.env.*)", "Read(**/*.pem)", "Read(**/*.key)",
      "Bash(cat *.env*)", "Bash(type *.env*)", "Bash(printenv*)", "Bash(set)",
      "Bash(git push --force*)", "Bash(git push -f*)", "Bash(git reset --hard*)",
      "Bash(rm -rf *)", "Bash(rd /s *)", "Bash(del /s *)",
      "Bash(vercel --prod*)", "Bash(npx vercel --prod*)", "Bash(npx vercel deploy --prod*)", "Bash(vercel deploy --prod*)",
      "Bash(gh secret *)", "Bash(npx supabase db reset*)", "Bash(npx supabase db pull*)", "Bash(npx supabase db diff*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/guard-prod.mjs" }
        ]
      }
    ]
  }
}
